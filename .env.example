# ==============================================================================
# SocietySaver Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION & GENERAL CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME=Socievo
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=socievo_user
POSTGRES_PASSWORD=socievo_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=socievo_db
DATABASE_URL=postgresql+asyncpg://socievo_user:socievo_password@localhost:5432/socievo_db
DATABASE_URL_SYNC=postgresql://socievo_user:socievo_password@localhost:5432/socievo_db

# ------------------------------------------------------------------------------
# CACHE & ASYNC QUEUE (Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# PAYMENTS (Razorpay / Test Mock Boundary)
# ------------------------------------------------------------------------------
# Set PAYMENT_MODE to 'mock' for local development & automated test suites
# Set to 'razorpay' when valid Razorpay API keys are configured
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_key

# ------------------------------------------------------------------------------
# NOTIFICATIONS & COMMUNICATIONS
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=notifications@socievo.local
EMAILS_FROM_NAME="Socievo Platform"

# ------------------------------------------------------------------------------
# STORAGE (Local File System or S3 Compatible)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET_NAME=societysaver-uploads
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

# ------------------------------------------------------------------------------
# PLATFORM DEFAULTS & REVENUE CONFIGURATION
# ------------------------------------------------------------------------------
PLATFORM_DEFAULT_CURRENCY=INR
PLATFORM_DEFAULT_COMMISSION_PERCENTAGE=10.0
PLATFORM_TAX_PERCENTAGE=18.0
